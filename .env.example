# Copy to .env and fill in. .env is gitignored — never commit real secrets,
# and never zip this folder by hand: use scripts/make_release.py (it refuses
# to package a .env).

# ---- Binance SPOT TESTNET (fake money) -------------------------------------
# Only needed for the bot/execution phase. The analyst's market data comes from
# free public endpoints and needs no key.
BINANCE_TESTNET=true
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# ---- Data & exchange --------------------------------------------------------
# ANALYST_DATA_DIR=./data            # DuckDB + raw payload archive location
# ANALYST_EXCHANGE=binance           # or: cryptocom

# ---- Sentiment engine (optional, separate service) --------------------------
# SENTIMENT_API_BASE=http://127.0.0.1:8787

# ---- Background scheduler (off by default; launchers set it) ----------------
# ANALYST_SCHEDULER=0                # 1/true to enable background ingestion
# ANALYST_SCHEDULER_SYMBOLS=BTC_USDT,ETH_USDT,ROBO_USDC
# ANALYST_SCHEDULER_TIMEFRAMES=1h,4h,1D
# ANALYST_SCHED_CANDLES_S=300        # seconds between candle refreshes
# ANALYST_SCHED_MICRO_S=120          # order-book/microstructure snapshots
# ANALYST_SCHED_FUNDING_S=1800       # funding history
# ANALYST_SCHED_JOURNAL_S=900        # alert journal
# ANALYST_SCHED_VRP_S=21600          # daily VRP signal (deduped)
# ANALYST_SCHED_METRICS_S=1800       # sentiment/on-chain history snapshots (P1.1)
